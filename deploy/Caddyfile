# Reverse proxy + automatic HTTPS for Mission Control.
#
# Set to mission.atesflowagency.com — a new subdomain, not the domain's
# apex, which already points at the separate VPS running n8n. Point this
# subdomain's own DNS A record at *this* VPS's IP first — Caddy requests
# the TLS certificate on first start and needs that to already resolve.
# It doesn't touch the apex record or n8n's OAuth redirect URIs, which
# are registered against that separate hostname.
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# The dashboard has no login of its own — every page and every server
# action (approve, run agent, delete memory...) trusts whoever can reach
# it. So everything on this domain sits behind HTTP Basic Auth, except the
# three webhook paths that already carry their own secret check and whose
# callers (Telegram, Resend, a cron service) cannot supply a username and
# password: TELEGRAM_WEBHOOK_SECRET header, Svix signature, and the
# CRON_SECRET header respectively.
#
# Generate your own hash before first use — never commit a real one here:
#   caddy hash-password
# Replace REPLACE_WITH_YOUR_OWN_HASH below with its output, and "ates"
# with whatever username you want to type at the prompt.

mission.atesflowagency.com {
	@webhooks path /api/telegram* /api/resend* /api/tick*

	handle @webhooks {
		reverse_proxy localhost:3000
	}

	handle {
		basicauth {
			ates REPLACE_WITH_YOUR_OWN_HASH
		}
		reverse_proxy localhost:3000
	}
}
