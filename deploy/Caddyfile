# Reverse proxy + automatic HTTPS for Mission Control.
#
# Set to mission.atesflowagency.com — a new subdomain, not the domain's
# apex, which already points at the separate VPS running n8n. Point this
# subdomain's own DNS A record at *this* VPS's IP first — Caddy requests
# the TLS certificate on first start and needs that to already resolve.
# It doesn't touch the apex record or n8n's OAuth redirect URIs, which
# are registered against that separate hostname.
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Both the dashboard and everything under /api/ (the Telegram webhook,
# /api/tick if you ever want the HTTP path too) live on the same Next.js
# app, so one proxy block covers all of it — no path routing needed.

mission.atesflowagency.com {
	reverse_proxy localhost:3000
}
