node_modules/
.next/

# Root-anchored on purpose. Unanchored, "build/" matches a directory named
# build at ANY depth — which silently swallowed agents/automation/build/,
# the Build department of the automation branch. Keep the leading slash.
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# Local PGlite database lives here. Never committed.
/data/

.env
.env.*
!.env.example

# The seeded design canvas carries the whole editor payload (~2.3 MB) and is
# reproducible from .design/*.dc.html + canvas.json + _build.py. Sources are
# committed; the build output is not.
/.design/mission-control-panel.html

.DS_Store
*.pem
npm-debug.log*
.vercel
